<?xml version="1.0" encoding="utf-8"?>
<!--
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Tasker 태스크: 골프존스코어수집                                         │
  │                                                                         │
  │  [동작 흐름]                                                             │
  │  1. 골프존 앱 실행                                                       │
  │  2. 전체메뉴 → 네트워크플레이 → 최근 경기 클릭                          │
  │  3. 참가자 목록 uiautomator dump 후 Python 파싱                         │
  │  4. 각 참가자 클릭 → 스코어카드 dump → back                            │
  │  5. Python으로 전체 스코어카드 PDF 생성                                 │
  │                                                                         │
  │  [필수 앱 및 설정]                                                       │
  │  • Tasker (유료)                                                        │
  │  • AutoInput 플러그인 (Accessibility Service 활성화 필수)               │
  │  • Termux + Python3                                                     │
  │    pkg install python                                                   │
  │  • 스크립트 복사:                                                        │
  │    golfzon_scorecard.py  → /sdcard/golf_scripts/                        │
  │    golfzon_tasker_parse.py → /sdcard/golf_scripts/                      │
  │                                                                         │
  │  [가져오기 방법]                                                         │
  │  1. 이 파일을 /sdcard/Download/ 에 복사                                 │
  │  2. Tasker → ⋮ → Data → Restore User Data → 이 파일 선택              │
  │  3. Task 항목만 체크 후 OK                                              │
  └─────────────────────────────────────────────────────────────────────────┘
-->
<TaskerData sr="" dvi="1" tv="6.3.13">

  <Task sr="task1">
    <cdate>1710000000000</cdate>
    <edate>1710000000000</edate>
    <id>1</id>
    <nme>골프존스코어수집</nme>
    <pri>100</pri>

    <!-- ════════════════════════════════════════
         ①  작업 폴더 초기화
         ════════════════════════════════════════ -->
    <Action sr="act0" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3">mkdir -p /sdcard/Pictures/golf_scores &amp;&amp; rm -f /sdcard/Pictures/golf_scores/*.xml &amp;&amp; echo "INIT_OK"</Str>
      <Str sr="arg1" ve="3">%INITOUT</Str>
      <Int sr="arg2" val="10"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ②  골프존 앱 실행
         ════════════════════════════════════════ -->
    <Action sr="act1" ve="7">
      <code>535</code>
      <Str sr="arg0" ve="3">com.golfzon.android</Str>
      <Str sr="arg1" ve="3"></Str>
      <Int sr="arg2" val="0"/>
    </Action>

    <!-- ③  앱 로딩 대기 (4초) -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="4"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ════════════════════════════════════════
         ④  하단 "전체메뉴" 클릭
         ════════════════════════════════════════ -->
    <Action sr="act3" ve="7">
      <code>300</code>
      <Bundle sr="arg0">
        <Str sr="action">click</Str>
        <Str sr="elementtext">전체메뉴</Str>
        <Int sr="timeout" val="6000"/>
      </Bundle>
      <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
      <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
    </Action>

    <!-- ⑤  메뉴 로딩 대기 -->
    <Action sr="act4" ve="7">
      <code>30</code>
      <Int sr="arg0" val="2"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ════════════════════════════════════════
         ⑥  "네트워크플레이" 클릭
         ════════════════════════════════════════ -->
    <Action sr="act5" ve="7">
      <code>300</code>
      <Bundle sr="arg0">
        <Str sr="action">click</Str>
        <Str sr="elementtext">네트워크플레이</Str>
        <Int sr="timeout" val="6000"/>
      </Bundle>
      <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
      <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
    </Action>

    <!-- ⑦  경기 목록 로딩 대기 -->
    <Action sr="act6" ve="7">
      <code>30</code>
      <Int sr="arg0" val="2"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ════════════════════════════════════════
         ⑧  첫 번째(최근) 경기 클릭
             ※ 경기 목록의 첫 번째 아이템 탭
                AutoInput Index 기반 클릭
         ════════════════════════════════════════ -->
    <Action sr="act7" ve="7">
      <code>300</code>
      <Bundle sr="arg0">
        <Str sr="action">click</Str>
        <Int sr="elementindex" val="0"/>
        <Str sr="elementtype">android.widget.LinearLayout</Str>
        <Int sr="timeout" val="6000"/>
      </Bundle>
      <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
      <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
    </Action>

    <!-- ⑨  스트로크 결과 화면 로딩 대기 -->
    <Action sr="act8" ve="7">
      <code>30</code>
      <Int sr="arg0" val="3"/>
      <Str sr="arg1" ve="3">Seconds</Str>
    </Action>

    <!-- ════════════════════════════════════════
         ⑩  랭킹 화면 UI dump
             → /sdcard/Pictures/golf_scores/ranking.xml
         ════════════════════════════════════════ -->
    <Action sr="act9" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3">uiautomator dump /sdcard/Pictures/golf_scores/ranking.xml &amp;&amp; echo "DUMP_OK"</Str>
      <Str sr="arg1" ve="3">%DUMPOUT</Str>
      <Int sr="arg2" val="15"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ⑪  Python으로 참가자 목록 추출
             출력: {"count":16,"names":["[늘푸른]","bonteng",...],"data":[...]}
         ════════════════════════════════════════ -->
    <Action sr="act10" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3">python3 /sdcard/golf_scripts/golfzon_tasker_parse.py --list /sdcard/Pictures/golf_scores/ranking.xml</Str>
      <Str sr="arg1" ve="3">%PLAYERS_JSON</Str>
      <Int sr="arg2" val="30"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ⑫  JavaScript로 JSON 파싱
             %PLAYER_COUNT, %PLAYER_NAMES (| 구분)
         ════════════════════════════════════════ -->
    <Action sr="act11" ve="7">
      <code>122</code>
      <Str sr="arg0" ve="3">var d=JSON.parse(players_json);
setLocal('player_count', String(d.count));
setLocal('player_names', d.names.join('|'));</Str>
      <Str sr="arg1" ve="3">players_json</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ⑬  참가자 배열 분리
             %PLAYER_NAMES → %PLAYER_NAMES(1), (2), ...
         ════════════════════════════════════════ -->
    <Action sr="act12" ve="7">
      <code>135</code>
      <Str sr="arg0" ve="3">%PLAYER_NAMES</Str>
      <Str sr="arg1" ve="3">|</Str>
      <Int sr="arg2" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ⑭  참가자 루프 시작
         ════════════════════════════════════════ -->
    <Action sr="act13" ve="7">
      <code>500</code>
      <Str sr="arg0" ve="3">%PNAME</Str>
      <Int sr="arg1" val="0"/>
      <Str sr="arg2" ve="3">%PLAYER_NAMES()</Str>
    </Action>

      <!-- ──────────────────────────────────────
           ⑮  참가자 이름 클릭 (스코어카드 펼침)
           ────────────────────────────────────── -->
      <Action sr="act14" ve="7">
        <code>300</code>
        <Bundle sr="arg0">
          <Str sr="action">click</Str>
          <Str sr="elementtext">%PNAME</Str>
          <Int sr="timeout" val="6000"/>
        </Bundle>
        <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
        <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
      </Action>

      <!-- ⑯  스코어카드 로딩 대기 -->
      <Action sr="act15" ve="7">
        <code>30</code>
        <Int sr="arg0" val="2"/>
        <Str sr="arg1" ve="3">Seconds</Str>
      </Action>

      <!-- ──────────────────────────────────────
           ⑰  스코어카드 화면 UI dump
               파일명: score_[참가자이름].xml
               ※ 특수문자가 있으면 파일명 오류 가능
                 → Python에서 안전하게 처리
           ────────────────────────────────────── -->
      <Action sr="act16" ve="7">
        <code>664</code>
        <Str sr="arg0" ve="3">uiautomator dump "/sdcard/Pictures/golf_scores/score_%PNAME.xml" &amp;&amp; echo "OK"</Str>
        <Str sr="arg1" ve="3">%SHERR</Str>
        <Int sr="arg2" val="15"/>
        <Int sr="arg3" val="0"/>
        <Int sr="arg4" val="1"/>
        <Int sr="arg5" val="1"/>
      </Action>

      <!-- ⑱  스코어카드 닫기 (back 버튼) -->
      <Action sr="act17" ve="7">
        <code>102</code>
        <Str sr="arg0" ve="3">BACK</Str>
      </Action>

      <!-- ⑲  다음 참가자 로딩 대기 -->
      <Action sr="act18" ve="7">
        <code>30</code>
        <Int sr="arg0" val="1500"/>
        <Str sr="arg1" ve="3">MS</Str>
      </Action>

    <!-- ════════════════════════════════════════
         ⑳  루프 종료
         ════════════════════════════════════════ -->
    <Action sr="act19" ve="7">
      <code>502</code>
    </Action>

    <!-- ════════════════════════════════════════
         ㉑  Python으로 전체 스코어카드 PDF 생성
         ════════════════════════════════════════ -->
    <Action sr="act20" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3">python3 /sdcard/golf_scripts/golfzon_tasker_parse.py --generate /sdcard/Pictures/golf_scores/ &amp;&amp; echo "PDF_OK"</Str>
      <Str sr="arg1" ve="3">%PDFOUT</Str>
      <Int sr="arg2" val="120"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="1"/>
      <Int sr="arg5" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════
         ㉒  완료 알림 토스트
         ════════════════════════════════════════ -->
    <Action sr="act21" ve="7">
      <code>7</code>
      <Str sr="arg0" ve="3">골프존 스코어수집 완료 ✓</Str>
      <Str sr="arg1" ve="3">PDF가 ~/sundayscreen/ 에 저장되었습니다.</Str>
      <Int sr="arg2" val="0"/>
    </Action>

  </Task>

</TaskerData>
