<?xml version="1.0" encoding="utf-8"?>
<!--
  ┌─────────────────────────────────────────────────────────────────────────┐
  │  Tasker 태스크: 카톡만평전송                                             │
  │                                                                         │
  │  [가져오기 방법]                                                         │
  │  1. 이 파일을 /sdcard/Download/ 에 복사                                 │
  │  2. Tasker 실행 → 우상단 ⋮ 메뉴 → Data → Restore User Data             │
  │  3. 이 파일 선택 → Task 항목만 체크 후 OK                               │
  │                                                                         │
  │  [필수 앱]                                                              │
  │  • Tasker (유료)                                                        │
  │  • AutoInput 플러그인 (Tasker 제작사 joaomgcd)                          │
  │  • Termux (python3, termux-api 설치 완료 상태)                          │
  │                                                                         │
  │  [AutoInput 첫 실행 전]                                                 │
  │  AutoInput → Enable Accessibility Service 를 반드시 활성화할 것         │
  └─────────────────────────────────────────────────────────────────────────┘
-->
<TaskerData sr="" dvi="1" tv="6.3.13">

  <Task sr="task1">
    <cdate>1710000000000</cdate>
    <edate>1710000000000</edate>
    <id>1</id>
    <nme>카톡만평전송</nme>
    <pri>100</pri>

    <!-- ════════════════════════════════════════════
         ①  JSON manifest 파일 읽기
             /sdcard/Pictures/naver_manhwa/kakao_send.json
             → %KDATA 변수에 저장
         ════════════════════════════════════════════ -->
    <Action sr="act0" ve="7">
      <code>548</code>
      <Str sr="arg0" ve="3">/sdcard/Pictures/naver_manhwa/kakao_send.json</Str>
      <Str sr="arg1" ve="3">%KDATA</Str>
      <Int sr="arg2" val="0"/>
    </Action>

    <!-- ════════════════════════════════════════════
         ②  JavaScript 로 JSON 파싱
             files  → %KFILESRAW (| 구분)
             rooms  → %KROOMSRAW (| 구분)
         ════════════════════════════════════════════ -->
    <Action sr="act1" ve="7">
      <code>122</code>
      <Str sr="arg0" ve="3">var d=JSON.parse(kdata);
setLocal('kfilesraw', d.files.join('|'));
setLocal('kroomsraw', d.rooms.join('|'));</Str>
      <Str sr="arg1" ve="3">kdata</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════════
         ③  방 목록 배열 분리 → %KROOMSRAW(1), (2) ...
         ════════════════════════════════════════════ -->
    <Action sr="act2" ve="7">
      <code>135</code>
      <Str sr="arg0" ve="3">%KROOMSRAW</Str>
      <Str sr="arg1" ve="3">|</Str>
      <Int sr="arg2" val="1"/>
    </Action>

    <!-- ════════════════════════════════════════════
         ④  방 루프 시작  (%ROOM = "취사" → "연토91")
         ════════════════════════════════════════════ -->
    <Action sr="act3" ve="7">
      <code>500</code>
      <Str sr="arg0" ve="3">%ROOM</Str>
      <Int sr="arg1" val="0"/>
      <Str sr="arg2" ve="3">%KROOMSRAW()</Str>
    </Action>

      <!-- ──────────────────────────────────────────
           ⑤  Shell: Python 으로 am SEND_MULTIPLE 실행
               • Python 이 | 구분 파일 목록을 분리해
                 각 파일에 --eu 를 붙여 am start 호출
               • KakaoTalk 공유 화면(받는 사람 선택)이 뜸
           ────────────────────────────────────────── -->
      <Action sr="act4" ve="7">
        <code>664</code>
        <Str sr="arg0" ve="3">python3 - &lt;&lt;'PYEOF'
import subprocess, os
raw = "%KFILESRAW"
files = [f for f in raw.split("|") if f.strip()]
if not files:
    raise SystemExit("파일 없음")
cmd = ["am","start",
       "-a","android.intent.action.SEND_MULTIPLE",
       "-t","image/*"]
for f in files:
    f = f.strip()
    cmd += ["--eu","android.intent.extra.STREAM","file://"+f]
cmd += ["-p","com.kakao.talk"]
subprocess.run(cmd, check=True)
PYEOF</Str>
        <Str sr="arg1" ve="3">%SHERR</Str>
        <Int sr="arg2" val="30"/>
        <Int sr="arg3" val="0"/>
        <Int sr="arg4" val="1"/>
        <Int sr="arg5" val="1"/>
      </Action>

      <!-- ⑥  카톡 공유 화면 로딩 대기 (3초) -->
      <Action sr="act5" ve="7">
        <code>30</code>
        <Int sr="arg0" val="3"/>
        <Str sr="arg1" ve="3">Seconds</Str>
      </Action>

      <!-- ──────────────────────────────────────────
           ⑦  AutoInput: 공유 화면 검색창에 방 이름 입력
               • KakaoTalk 공유 화면 상단 검색창에 포커스
                 후 %ROOM 문자 입력
           ────────────────────────────────────────── -->
      <Action sr="act6" ve="7">
        <code>300</code>
        <Bundle sr="arg0">
          <Str sr="action">text</Str>
          <Str sr="text">%ROOM</Str>
          <Str sr="type">et</Str>
          <Int sr="timeout" val="6000"/>
        </Bundle>
        <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
        <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
      </Action>

      <!-- ⑧  검색 결과 표시 대기 (1.5초) -->
      <Action sr="act7" ve="7">
        <code>30</code>
        <Int sr="arg0" val="1500"/>
        <Str sr="arg1" ve="3">MS</Str>
      </Action>

      <!-- ──────────────────────────────────────────
           ⑨  AutoInput: 검색 결과에서 방 이름 탭
               • 텍스트가 %ROOM 인 항목을 찾아 클릭
           ────────────────────────────────────────── -->
      <Action sr="act8" ve="7">
        <code>300</code>
        <Bundle sr="arg0">
          <Str sr="action">click</Str>
          <Str sr="elementtext">%ROOM</Str>
          <Int sr="timeout" val="6000"/>
        </Bundle>
        <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
        <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
      </Action>

      <!-- ⑩  선택 반영 대기 (1초) -->
      <Action sr="act9" ve="7">
        <code>30</code>
        <Int sr="arg0" val="1"/>
        <Str sr="arg1" ve="3">Seconds</Str>
      </Action>

      <!-- ──────────────────────────────────────────
           ⑪  AutoInput: "확인" 버튼 탭 → 전송 완료
               ※ 기기/버전에 따라 버튼 텍스트가
                 "전송", "보내기" 일 수 있음 → 수동 확인
           ────────────────────────────────────────── -->
      <Action sr="act10" ve="7">
        <code>300</code>
        <Bundle sr="arg0">
          <Str sr="action">click</Str>
          <Str sr="elementtext">확인</Str>
          <Int sr="timeout" val="6000"/>
        </Bundle>
        <Str sr="arg1" ve="3">com.joaomgcd.autoinput</Str>
        <Str sr="arg2" ve="3">com.joaomgcd.autoinput.Plugin</Str>
      </Action>

      <!-- ⑫  전송 완료 대기 후 다음 방으로 (3초) -->
      <Action sr="act11" ve="7">
        <code>30</code>
        <Int sr="arg0" val="3"/>
        <Str sr="arg1" ve="3">Seconds</Str>
      </Action>

    <!-- ════════════════════════════════════════════
         ⑬  End For
         ════════════════════════════════════════════ -->
    <Action sr="act12" ve="7">
      <code>502</code>
    </Action>

  </Task>

</TaskerData>
